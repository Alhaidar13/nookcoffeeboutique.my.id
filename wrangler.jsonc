{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-10-23",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      // Ganti dengan ID asli dari `npx wrangler d1 create webapp-production` saat deploy produksi
      "database_id": "3b920424-0881-4d17-b330-a69b994f5f17"
    }
  ]
}
